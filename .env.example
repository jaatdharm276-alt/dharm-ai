# Required for ORION AI chat and JARVIS agent reasoning
GROQ_API_KEY=

# Enable free Tavily keyless web search (no account, API key, or payment required).
# Tavily applies its own rate limits to keyless requests.
ORION_ENABLE_EXTERNAL_SEARCH=true

# Optional: add a Tavily key for account-based quota (e.g. free monthly credits).
# Never enable paid overages unless you explicitly choose to.
TAVILY_API_KEY=

# GitHub App repository connection (server-side only; never expose these as NEXT_PUBLIC_ vars).
# App ID is not the Client ID. Create a private key in GitHub App settings.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Generate a random secret with at least 32 characters for signed, HttpOnly installation cookies.
GITHUB_APP_SESSION_SECRET=
