# Required for ORION AI chat and JARVIS agent reasoning
GROQ_API_KEY=

# Enable free Tavily keyless web search (no account, API key, or payment required).
# Tavily applies its own rate limits to keyless requests.
ORION_ENABLE_EXTERNAL_SEARCH=true

# Optional: add a Tavily key for account-based quota (e.g. free monthly credits).
# Never enable paid overages unless you explicitly choose to.
TAVILY_API_KEY=
